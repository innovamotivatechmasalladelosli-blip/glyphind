{
  "name": "glyphind",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-dev.mjs && vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && npm run build:worker && node scripts/build-pages.mjs",
    "build:worker": "vite build --config workers/url-reader/vite.config.ts",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.19.4"
  }
}
